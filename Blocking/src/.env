# ==============================================================================
# GLOBAL PIPELINE CONFIGURATION — Amazon ML Challenge ER Pipeline
# All tunable values are declared here. src/config.py reads this file.
# Options are listed as comments where multiple valid values exist.
# ==============================================================================

# ─────────────────────────────────────────────────────────────────────────────
# SYSTEM
# ─────────────────────────────────────────────────────────────────────────────
RANDOM_SEED=42
# Pipeline execution mode. Options: train | infer
PIPELINE_MODE=infer


# ─────────────────────────────────────────────────────────────────────────────
# PATHS
# ─────────────────────────────────────────────────────────────────────────────
DATA_DIR_TRAIN=dataset/train
DATA_DIR_TEST=dataset/test
GROUND_TRUTH_PATH=dataset/train/train_ground_truth.tsv
PROCESSED_DATA_DIR=data/processed
MODEL_OUTPUT_PATH=models/xgb_model.pkl
OUTPUT_DIR=output/


# ─────────────────────────────────────────────────────────────────────────────
# PHASE 0: PREPROCESSING & PARTITIONING
# ─────────────────────────────────────────────────────────────────────────────

# Comma-separated list of string literals to treat as missing values
NULL_LITERALS=n/a,na,null,none,-

# Sentinel prefix used for missing business names and addresses. Appended with entity_id.
# Format: "<NULLNAME_PREFIX> <entity_id>"
# These variables are exposed for the blocking_utils module to intercept and prevent index pollution.
# Possible values: Any string (e.g., "nullname", "nan_name", "missing"). Must match the values used during dataset preprocessing.
NULLNAME_PREFIX=nullname

# Possible values: Any string (e.g., "nulladdr", "nan_addr", "missing"). Must match the values used during dataset preprocessing.
NULLADDR_PREFIX=nulladdr

# Enable Indic-script transliteration for BM25 representations.
# Options: true | false
ENABLE_TRANSLITERATION=true

# Transliteration target scheme (used by indic-transliteration library).
# Options: itrans | slp1 | hk | iast | wx | kolkata | velthuis
TRANSLITERATION_SCHEME=itrans

# Symbol substitution rules for BM25 normalization
SYMBOL_AT_REPLACEMENT= at
SYMBOL_AMP_REPLACEMENT= and

# Parquet output compression codec (affects I/O speed vs disk size trade-off).
# Options: snappy | gzip | brotli | zstd | lz4 | uncompressed
PARQUET_COMPRESSION=snappy


# ─────────────────────────────────────────────────────────────────────────────
# PHASE 1–2: BLOCKING — FAISS (SEMANTIC NAME STREAM)
# ─────────────────────────────────────────────────────────────────────────────

# HuggingFace sentence-transformer model for FAISS name embeddings.
# This variable is exposed to the semantic_index module.
# Options (multilingual): paraphrase-multilingual-MiniLM-L12-v2 |
#                         paraphrase-multilingual-mpnet-base-v2 |
#                         LaBSE
# Options (English-only, faster): all-MiniLM-L6-v2 | all-mpnet-base-v2
SENTENCE_TRANSFORMER_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# Batch size for GPU embedding generation. Tune based on available VRAM.
# This variable is exposed to the semantic_index module.
# RTX 3060 6GB: ~256. Lower if OOM. Higher if GPU has headroom.
FAISS_EMBED_BATCH_SIZE=256

# FAISS index type.
# This variable is exposed to the semantic_index module.
# Options: IndexFlatIP (exact, cosine w/ L2-norm) |
#          IndexFlatL2 (exact, Euclidean) |
#          IndexIVFFlat (approximate, faster for >100k targets) |
#          IndexHNSWFlat (approximate, best recall/speed trade-off)
FAISS_INDEX_TYPE=IndexFlatIP

# Number of IVF clusters (only used if FAISS_INDEX_TYPE=IndexIVFFlat).
# Rule of thumb: sqrt(n_target_vectors). E.g., sqrt(2,200,000) ≈ 1483
FAISS_IVF_NLIST=1024

# Number of probes for IVF search (only used if IndexIVFFlat).
# Higher = better recall, slower. Options: 1–FAISS_IVF_NLIST.
FAISS_IVF_NPROBE=64

# HNSW construction parameter M (only used if IndexHNSWFlat).
# Higher M = better recall, more memory. Typical range: 16–64.
FAISS_HNSW_M=32

# FAISS distance metric.
# Options: METRIC_INNER_PRODUCT | METRIC_L2
# Note: METRIC_INNER_PRODUCT requires L2-normalized vectors for cosine similarity.
FAISS_METRIC=METRIC_INNER_PRODUCT

# FAISS OpenMP thread limit. 
# This variable is exposed to the semantic_index module.
# To prevent thread thrashing in a multiprocessing DAG environment, this is strictly set to 1.
# Options: 1 (recommended for multiprocessing) | Any positive integer
FAISS_OMP_NUM_THREADS=1


# ─────────────────────────────────────────────────────────────────────────────
# PHASE 1–2: BLOCKING — BM25 (LEXICAL STREAMS)
# ─────────────────────────────────────────────────────────────────────────────

# BM25 character n-gram size. Affects lexical recall.
# Options: 2 (bigrams, aggressive) | 3 (trigrams, balanced) | 4 (quadgrams, precise)
BM25_NGRAM_SIZE=3

# BM25_K1: Term frequency saturation. This variable is exposed to the bm25_utils, lexical_addr_index, and lexical_name_index modules.
# It determines how much a single repeated term scales the score.
# Higher value = more weight on repeated terms.
# Possible values: Any float >= 0.0.
# Typical range: 1.2 to 2.0. (Default in rank-bm25: 1.5)
BM25_K1=1.5

# BM25_B: Length normalization. This variable is exposed to the bm25_utils, lexical_addr_index, and lexical_name_index modules.
# It determines the scaling effect of document length compared to average document length (avgdl).
# 1.0 = full normalization (penalizes long documents), 0.0 = no length normalization.
# Possible values: Any float between 0.0 and 1.0. (Default in rank-bm25: 0.75)
BM25_B=0.75

# BM25_EPSILON: Floor for IDF values (prevents negative IDF for very common terms).
# Possible values: Any positive float. (Default in rank-bm25: 0.25)
BM25_EPSILON=0.25


# ─────────────────────────────────────────────────────────────────────────────
# PHASE 1–2: BLOCKING — CYCLIC DAG ORCHESTRATOR
# ─────────────────────────────────────────────────────────────────────────────

# Base candidates to retrieve per stream per cycle.
# Total candidates per cycle <= 3 * DAG_K_BASE (after dedup).
DAG_K_BASE=20

# Hard cap on total unique candidates evaluated per S1 entity before force-halt.
# Formula: 3 streams * DAG_K_BASE * DAG_MIN_CYCLES = MAX_SEEN (e.g., 3*20*3=90)
DAG_MAX_SEEN=90

# Minimum cycles before the "0 new matches" stopping condition is allowed to trigger.
# Set >= 2 to prevent premature termination on the first cycle.
DAG_MIN_CYCLES=3


# ─────────────────────────────────────────────────────────────────────────────
# PHASE 1-2: BLOCKING — SEEN DICTIONARY STATE MANAGER
# ─────────────────────────────────────────────────────────────────────────────

# The micro-batch buffer size for the seen_dict global state tracker.
# Once the buffer reaches this limit, it flushes finalized entities to the state.jsonl file
# and instantly clears them from active memory to prevent OOM errors on large datasets.
# Recommended Options: 10000 (typical), 5000 (low memory), 50000 (high memory).
BATCH_SIZE=10000


# ─────────────────────────────────────────────────────────────────────────────
# PHASE 3: FEATURE ENGINEERING
# ─────────────────────────────────────────────────────────────────────────────

# RRF rank constant (k in formula: 1/(k + rank)). Computed per stream.
# Higher k = dampens rank differences. Industry default: 60.
RRF_K_BM25_NAME=60
RRF_K_BM25_ADDR=60
RRF_K_FAISS=60

# BM25 self-score floor to prevent divide-by-zero during self-normalization.
BM25_SELF_SCORE_FLOOR=1e-9

# Jaro-Winkler prefix weight (p). Standard range: 0.0–0.25.
# Higher p = more weight on shared prefix characters. Library default: 0.1
JARO_WINKLER_PREFIX_WEIGHT=0.1

# Country Target Encoder CV folds (number of cross-val splits within TargetEncoder).
# Options: 3 | 5 | 10. Higher = more robust but slower.
TARGET_ENCODER_CV=5

# Country Target Encoder type.
# Options: TargetEncoder | OrdinalEncoder
# Note: OrdinalEncoder uses unknown_value=-1 for unseen countries (e.g., France).
COUNTRY_ENCODER_TYPE=TargetEncoder


# ─────────────────────────────────────────────────────────────────────────────
# PHASE 4: ML CLASSIFICATION — MODEL SELECTION
# ─────────────────────────────────────────────────────────────────────────────

# ML backend to use for training and inference.
# Options: xgboost | lightgbm
ML_BACKEND=xgboost


# ─────────────────────────────────────────────────────────────────────────────
# PHASE 4: ML CLASSIFICATION — OPTUNA HPO
# ─────────────────────────────────────────────────────────────────────────────
OPTUNA_N_TRIALS=100
OPTUNA_TIMEOUT_SECONDS=3600
OPTUNA_SEED=42


# ─────────────────────────────────────────────────────────────────────────────
# PHASE 4: ML CLASSIFICATION — XGBOOST HYPERPARAMETERS
# (Only used if ML_BACKEND=xgboost)
# ─────────────────────────────────────────────────────────────────────────────

XGB_N_ESTIMATORS=1000
XGB_LEARNING_RATE=0.05
XGB_MAX_DEPTH=6

# Minimum sum of instance weight (Hessian) in a leaf node. Regularization.
XGB_MIN_CHILD_WEIGHT=5

# Subsample ratio of training instances per tree. Prevents overfitting.
# Options: 0.5–1.0
XGB_SUBSAMPLE=0.8

# Subsample ratio of features per tree.
# Options: 0.5–1.0
XGB_COLSAMPLE_BYTREE=0.8

# L1 regularization term on weights (alpha).
XGB_REG_ALPHA=0.1

# L2 regularization term on weights (lambda).
XGB_REG_LAMBDA=1.0

# Fraction of negative instances to subsample (speeds up large datasets).
# Options: 0.0–1.0. Use 1.0 to disable.
XGB_NEGATIVE_SUBSAMPLE_RATIO=1.0

# Scale positive weights to handle class imbalance.
# Set to -1 to auto-calculate as count(neg)/count(pos) at runtime.
XGB_SCALE_POS_WEIGHT=-1

# Early stopping: halt training if val metric doesn't improve for N rounds.
# Set to 0 to disable.
XGB_EARLY_STOPPING_ROUNDS=50

# Device. Options: cpu | cuda | gpu
XGB_DEVICE=cuda

# Eval metric for early stopping.
# Options: logloss | auc | aucpr | error
XGB_EVAL_METRIC=logloss

# Tree method. Options: hist | hist+cuda | exact | approx
XGB_TREE_METHOD=hist


# ─────────────────────────────────────────────────────────────────────────────
# PHASE 4: ML CLASSIFICATION — LIGHTGBM HYPERPARAMETERS
# (Only used if ML_BACKEND=lightgbm)
# ─────────────────────────────────────────────────────────────────────────────

LGBM_N_ESTIMATORS=1000
LGBM_LEARNING_RATE=0.05
LGBM_MAX_DEPTH=6
LGBM_NUM_LEAVES=63
LGBM_MIN_CHILD_SAMPLES=20
LGBM_SUBSAMPLE=0.8
LGBM_COLSAMPLE_BYTREE=0.8
LGBM_REG_ALPHA=0.1
LGBM_REG_LAMBDA=1.0
# Set to -1 to auto-calculate as count(neg)/count(pos) at runtime.
LGBM_SCALE_POS_WEIGHT=-1
LGBM_EARLY_STOPPING_ROUNDS=50
# Device. Options: cpu | gpu | cuda
LGBM_DEVICE=cpu
# Eval metric. Options: binary_logloss | auc | aucpr
LGBM_EVAL_METRIC=binary_logloss


# ─────────────────────────────────────────────────────────────────────────────
# PHASE 4: ML CLASSIFICATION — CROSS-VALIDATION & THRESHOLD
# ─────────────────────────────────────────────────────────────────────────────

# Number of GroupKFold folds (grouped by source1_entity_id).
# Options: 3 | 5 | 10
CV_FOLDS=5

# Threshold grid search bounds and step size.
THRESHOLD_SEARCH_START=0.50
THRESHOLD_SEARCH_END=0.99
THRESHOLD_SEARCH_STEP=0.01

# F-beta score beta for threshold optimization. 0.5 = penalize FP 2x more than FN.
# Options: 0.5 (F0.5, precision-heavy) | 1.0 (F1, balanced) | 2.0 (F2, recall-heavy)
FBETA_SCORE_BETA=0.5
